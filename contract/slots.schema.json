{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eereum-studio/slots.schema.json",
  "title": "eereum 이미지 교체 스튜디오 · 칸 목록 (약속 v1 · PC9 · 2026-11-17)",
  "description": "대장 창 · 도우미 · 미리보기 창 · 사이트 PR이 같이 쓰는 칸 목록 모양. 도우미가 매번 사이트 코드(content/media.ts · 화면 코드)에서 새로 만든다. 칸 ID는 화면 순서로 다시 붙을 수 있으므로, 칸을 오래 가리킬 때는 key(= data-slot 이름)를 쓴다.",
  "type": "object",
  "required": ["version", "source", "pages", "slots"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1, "description": "약속 판. 모양이 바뀌면 PC9가 올리고 진행판에 알림" },
    "source": {
      "type": "object",
      "required": ["repoCommit", "generatedAt"],
      "additionalProperties": false,
      "properties": {
        "repoCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "읽은 사이트 저장소 커밋" },
        "branch": { "type": "string", "description": "main 또는 수정안(PR) 브랜치 이름" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pageId", "name", "paths"],
        "additionalProperties": false,
        "properties": {
          "pageId": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" }, "description": "한국어 주소(언어 접두어 없음 · 예: /, /ring/mine). 다른 언어는 /en · /ja · /zh-hans · /zh-hant를 앞에 붙임" },
          "public": { "type": "boolean", "description": "false = 개발용(운영 사이트에 안 보임)", "default": true }
        }
      }
    },
    "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["slotId", "key", "pageId", "position", "kind", "accepts", "spec", "current", "dataSlot", "inUse"],
      "additionalProperties": false,
      "properties": {
        "slotId": { "type": "string", "pattern": "^P[0-9]{2}-[0-9]{2}$", "description": "P페이지번호-순번(그 페이지 안에서 화면 위 → 아래). 사람이 부르는 이름 · 파일 이름에 씀" },
        "key": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$", "description": "코드 이름 = content/media.ts 키. 오래 바뀌지 않는 진짜 이름" },
        "pageId": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "position": { "type": "string", "description": "화면 안 구역 이름(사람이 읽는 말)" },
        "paths": { "type": "array", "items": { "type": "string" }, "description": "이 칸이 보이는 주소(페이지 주소와 다를 때만 · 예: /rings/all · /search)" },
        "kind": { "enum": ["normal", "background", "share"], "description": "normal = 일반 그림 · background = 글 아래 배경(장식 · 대체 글 없음 가능) · share = 공유 미리보기(카카오톡 · SNS)" },
        "accepts": { "enum": ["image", "video", "both"], "description": "사이트가 지금 받는 종류(V8). both = 파일 끝으로 자동 구분(영상이면 poster 필수)" },
        "acceptsVerified": { "type": "boolean", "description": "V8에서 화면 코드로 확인했는지", "default": false },
        "spec": {
          "type": "object",
          "required": ["ratio"],
          "additionalProperties": false,
          "properties": {
            "ratio": { "type": "string", "pattern": "^[0-9.]+:[0-9.]+$", "description": "지금 파일 비율(가로:세로)" },
            "displayRatio": { "type": "string", "description": "화면 상자 비율(다르면 잘림 · 예: 모바일 1:1 · PC 5:4)" },
            "minWidth": { "type": "integer", "minimum": 1, "description": "권장 최소 가로 px(대장에서 '작음' 경고)" },
            "outputWidths": { "type": "array", "items": { "type": "integer" }, "description": "스튜디오가 줄여 만들 가로 px(기본 [960, 1600])" },
            "outputFormats": { "type": "array", "items": { "enum": ["webp", "jpg", "png", "mp4"] }, "description": "기본 [webp, jpg]" },
            "mobileCrop": { "enum": ["same", "separate-file", "focus"], "description": "same = 같은 그림 · separate-file = 모바일 파일 따로 · focus = 같은 그림에서 자르기 기준만" },
            "focus": { "type": "string", "description": "자르기 기준(center · top · 'x y' 0~1)" },
            "maxBytes": { "type": "integer", "description": "용량 경고 기준(없으면 이미지 600KB · 영상 8MB)" }
          }
        },
        "current": {
          "type": "object",
          "required": ["pc"],
          "additionalProperties": false,
          "properties": {
            "pc": { "$ref": "#/$defs/file" },
            "mobile": { "$ref": "#/$defs/file" },
            "poster": { "$ref": "#/$defs/file" },
            "sharedWith": { "type": "array", "items": { "type": "string" }, "description": "같은 파일을 쓰는 다른 칸 key(바꾸면 같이 바뀜 · 대장 경고)" }
          }
        },
        "alt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "description": "번역 키(content.json media.…)" },
            "ko": { "type": "string" }
          }
        },
        "source": { "type": "string", "description": "출처(자체 렌더 · Figma 임시 렌더 · Wikimedia CC BY-SA 3.0 …)" },
        "dataSlot": { "type": "string", "description": "사이트 그림에 붙는 숨은 표시 값(data-slot.md) = key" },
        "inUse": { "type": "boolean", "description": "false = 지금 화면에 안 쓰임(예비 칸)" },
        "note": { "type": "string" }
      }
    },
    "file": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^/", "description": "사이트 public 기준 주소(예: /media/home/hero.jpg)" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "format": { "type": "string" },
        "bytes": { "type": "integer" }
      }
    }
  }
}
